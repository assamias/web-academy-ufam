meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{base_url}}/users
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{name}}",
    "email": "{{email}}",
    "password": "123456",
    "userTypeId": "{{client}}"
  }
}

script:pre-request {
  const name = bru.interpolate("{{$randomFirstName}} {{$randomLastName}}");
  const email = bru.interpolate("{{$randomEmail}}");
  
  bru.setVar("name",name);
  bru.setVar("email",email)
}

settings {
  encodeUrl: true
  timeout: 0
}
